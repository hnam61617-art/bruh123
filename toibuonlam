v62.Mics:AddButton({
    Title = 'Hop Server',
    Description = '',
    Callback = function()
        u61:Dialog({
            Title = 'Hop Server',
            Content = '',
            Buttons = {
                {
                    Title = 'Ok',
                    Callback = function()
                        local _PlaceId = game.PlaceId
                        local u209 = {}
                        local u210 = ''
                        local _hour = os.date('!*t').hour

                        local function TPReturner()
                            local v212
                            if u210 ~= '' then
                                v212 = HttpService:JSONDecode(game:HttpGet('https://games.roblox.com/v1/games/' .. _PlaceId .. '/servers/Public?sortOrder=Asc&limit=100&cursor=' .. u210))
                            else
                                v212 = HttpService:JSONDecode(game:HttpGet('https://games.roblox.com/v1/games/' .. _PlaceId .. '/servers/Public?sortOrder=Asc&limit=100'))
                            end

                            if v212.nextPageCursor and v212.nextPageCursor ~= 'null' then
                                u210 = v212.nextPageCursor
                            end

                            for _, v217 in pairs(v212.data) do
                                local v218 = true
                                local u219 = tostring(v217.id)

                                if tonumber(v217.maxPlayers) > tonumber(v217.playing) then
                                    for v216, v223 in pairs(u209) do
                                        if v216 == 1 and tonumber(_hour) ~= tonumber(v223) then
                                            pcall(function()
                                                u209 = {_hour}
                                            end)
                                        elseif u219 == tostring(v223) then
                                            v218 = false
                                        end
                                    end

                                    if v218 then
                                        table.insert(u209, u219)
                                        pcall(function()
                                            TeleportService:TeleportToPlaceInstance(_PlaceId, u219, LocalPlayer)
                                        end)
                                        task.wait(0.1)
                                    end
                                end
                            end
                        end

                        task.spawn(function()
                            while task.wait(1) do
                                pcall(function()
                                    TPReturner()
                                end)
                            end
                        end)
                    end,
                },
                {
                    Title = 'No',
                    Callback = function() print('Cancelled the dialog.') end,
                },
            },
        })
    end,
})

v62.Mics:AddButton({
    Title = 'Low Server (Tối ưu giảm lag đồ họa)',
    Description = '',
    Callback = function()
        u61:Dialog({
            Title = 'Low Server',
            Content = '',
            Buttons = {
                {
                    Title = 'Ok',
                    Callback = function()
                        -- Tắt chi tiết nước
                        local terrain = Workspace:FindFirstChildOfClass('Terrain')
                        if terrain then
                            terrain.WaterWaveSize = 0
                            terrain.WaterWaveSpeed = 0
                            terrain.WaterReflectance = 0
                            terrain.WaterTransparency = 0
                        end
                        
                        Lighting.GlobalShadows = false
                        Lighting.FogEnd = 9e9
                        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

                        -- Tối ưu: Chỉ quét Workspace thay vì toàn bộ game
                        for _, v227 in pairs(Workspace:GetDescendants()) do
                            if v227:IsA('BasePart') then
                                v227.Material = Enum.Material.Plastic
                                v227.Reflectance = 0
                            elseif v227:IsA('Decal') then
                                v227.Transparency = 1
                            elseif v227:IsA('ParticleEmitter') or v227:IsA('Trail') then
                                v227.Lifetime = NumberRange.new(0)
                            elseif v227:IsA('Explosion') then
                                v227.BlastPressure = 1
                                v227.BlastRadius = 1
                            end
                        end

                        -- Tối ưu: Chỉ quét trong Lighting
                        for _, v231 in pairs(Lighting:GetDescendants()) do
                            if v231:IsA('PostEffect') then
                                v231.Enabled = false
                            end
                        end

                        Workspace.DescendantAdded:Connect(function(p232)
                            if p232:IsA('ForceField') or p232:IsA('Sparkles') or p232:IsA('Smoke') or p232:IsA('Fire') then
                                RunService.Heartbeat:Wait()
                                p232:Destroy()
                            end
                        end)
                    end,
                },
                {
                    Title = 'No',
                    Callback = function() print('Cancelled the dialog.') end,
                },
            },
        })
    end,
})

