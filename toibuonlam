-- [4] GỘP TOÀN BỘ HOOK (__namecall)
local oldNamecall
oldNamecall = hookmetamethod(game, '__namecall', function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if method == 'FireServer' or method == 'InvokeServer' then
        if self.Name == 'RemoteEvent' and args[3] == 'StopCharging' then
            if _G.auto100rate then args[6] = 100 end
        elseif self.Name == 'Drown' and _G.nowaterdamage and args[1] then
            return nil
        elseif self.Name == 'RequestAnimation' then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                if LocalPlayer.Character.Humanoid.Health == 0 then
                    args[1] = ''
                end
            end
        end
    end
    return oldNamecall(self, unpack(args))
end)

