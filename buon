-- ================================
local function EnsureSafeZone()
    local ws = workspace
    local sz = ws:FindFirstChild("SafeZoneOuterSpacePart")
    if not sz then
        local p = Instance.new("Part")
        p.Name = "SafeZoneOuterSpacePart"
        p.Anchored = true
        p.CanCollide = true
        p.Size = Vector3.new(200, 3, 200)
        p.Material = Enum.Material.Plastic
        p.Color = Color3.fromRGB(151, 151, 151)
        p.CFrame = CFrame.new(math.random(-100000, 100000), 10000, math.random(-100000, 100000))
        p.Parent = ws
    end
    return ws:FindFirstChild("SafeZoneOuterSpacePart")
end

