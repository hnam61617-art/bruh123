-- SafeTween estilo rápido/subida instantânea
getgenv().TweenSettings = getgenv().TweenSettings or {
    MaxSpeed = 250,
    MinTweenTime = 0.5,
    MaxTweenTime = 5,
    RandomDelay = {Min=0, Max=0}
}

function SafeTween(goalPos, radius)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - goalPos).Magnitude
    local cfg = getgenv().TweenSettings
    local tweenTime = math.clamp(distance / cfg.MaxSpeed, cfg.MinTweenTime, cfg.MaxTweenTime)

    -- Subida instantânea se distância grande
    if distance > 25 then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, math.clamp(distance * 5, 100, 500), 0)
        task.wait(0.1)
    end

    local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(goalPos + Vector3.new(0,5,0))})
    tween:Play()
    tween.Completed:Wait()

    task.wait(cfg.RandomDelay.Min + math.random() * (cfg.RandomDelay.Max - cfg.RandomDelay.Min))

    -- Click no raio
    if radius and radius > 0 then
        local parts = workspace:GetPartBoundsInRadius(goalPos, radius)
        for _, part in ipairs(parts) do
            for _, cd in ipairs(part:GetDescendants()) do
                if cd:IsA("ClickDetector") then
                    fireclickdetector(cd, 1)
                end
            end
        end
    end

    return true
end

-- Loop otimizado
spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not BringDF then continue end

        pcall(function()
            local player = LocalPlayer
            local character = player.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local frutasParaColetar = {}
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Tool") then
                    local raridade = obterRaridade(obj.Name)
                    if raridade ~= "Unknown" and table.find(collectRarities, raridade) then
                        local part = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                        if part then
                            table.insert(frutasParaColetar, {objeto=obj, raridade=raridade, part=part})
                        end
                    end
                end
            end

            -- Ordena por raridade + distância
            table.sort(frutasParaColetar, function(a,b)
                local prioridades = {Rare=1, Incommon=2, Common=3}
                local prioA, prioB = prioridades[a.raridade], prioridades[b.raridade]
                if prioA ~= prioB then return prioA < prioB end
                return (a.part.Position - hrp.Position).Magnitude < (b.part.Position - hrp.Position).Magnitude
            end)

            local collected = {}
            for i, fruta in ipairs(frutasParaColetar) do
                if not BringDF then break end
                if collected[fruta.objeto] then continue end

                local distToFruit = (fruta.part.Position - hrp.Position).Magnitude
                if distToFruit > ProximityThreshold then
                    SafeTween(fruta.part.Position, 10)
                end

                collectFruit(fruta.objeto)
                collected[fruta.objeto] = true

                -- Multi-coleta
                for j=i+1,#frutasParaColetar do
                    local outra = frutasParaColetar[j]
                    if not collected[outra.objeto] and outra.raridade == fruta.raridade then
                        if (outra.part.Position - fruta.part.Position).Magnitude <= MultiCollectRadius then
                            collectFruit(outra.objeto)
                            collected[outra.objeto] = true
                        end
                    end
                end
            end
        end)
    end
end)




