local HttpService = game:GetService("HttpService")

local webhookEnabled = false
local webhookURL = ""
local sendInterval = 1
local sendLoopActive = false

local function sendWebhookData()
    if not webhookEnabled or webhookURL == "" then
        warn("Webhook desativada ou URL não definida.")
        return
    end

    local player = game.Players.LocalPlayer
    local guiFrame = player.PlayerGui.Menu.Frame.C.Frame

    -- Coleta os valores da GUI
    local guiData = {
        Name = player.Name,
        TotalLevel = guiFrame.TotalLevel.Text,
        Beri = guiFrame.A.Beri.BeriAmount.Text,
        Bounty = guiFrame.A.Bounty.BountyAmount.Text,
        SamTimer = guiFrame.A.Sam.SamTimer.Text,
        Kills = guiFrame.A.Kills.KillsAmount.Text,
        Gems = guiFrame.A.Gems.GemsAmount.Text,
        Fish = guiFrame.A.Fish.FishAmount.Text,
        Defense = guiFrame.Defense.Text,
        Haki = guiFrame.Haki.Text,
        Melee = guiFrame.Melee.Text,
        Sniper = guiFrame.Sniper.Text,
        Sword = guiFrame.Sword.Text,
        Exp = guiFrame.B.Bar.Exp.Text, -- repete 2x mas é o mesmo
    }

    -- Campos do embed
    local fields = {
        { ["name"] = "Name", ["value"] = guiData.Name, ["inline"] = false },
        { ["name"] = "Total Level", ["value"] = guiData.TotalLevel, ["inline"] = true },
        { ["name"] = "Beri", ["value"] = guiData.Beri, ["inline"] = true },
        { ["name"] = "Bounty", ["value"] = guiData.Bounty, ["inline"] = true },
        { ["name"] = "Sam Timer", ["value"] = guiData.SamTimer, ["inline"] = true },
        { ["name"] = "Kills", ["value"] = guiData.Kills, ["inline"] = true },
        { ["name"] = "Gems", ["value"] = guiData.Gems, ["inline"] = true },
        { ["name"] = "Fish", ["value"] = guiData.Fish, ["inline"] = true },
        { ["name"] = "Defense", ["value"] = guiData.Defense, ["inline"] = true },
        { ["name"] = "Haki", ["value"] = guiData.Haki, ["inline"] = true },
        { ["name"] = "Melee", ["value"] = guiData.Melee, ["inline"] = true },
        { ["name"] = "Sniper", ["value"] = guiData.Sniper, ["inline"] = true },
        { ["name"] = "Sword", ["value"] = guiData.Sword, ["inline"] = true },
        { ["name"] = "Exp", ["value"] = guiData.Exp, ["inline"] = true },
    }

    http.request({
        Url = webhookURL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode({
            ["content"] = "",
            ["embeds"] = {
                {
                    ["title"] = "📊 Player Info",
                    ["color"] = tonumber(0xFF0000),
                    ["fields"] = fields,
                }
            }
        }),
    })

    print("Dados enviados para o webhook: GUI Infos.")
end

local function startWebhookLoop()
    if sendLoopActive then return end
    sendLoopActive = true

    while sendLoopActive do
        sendWebhookData()
        wait(sendInterval * 60)
    end
end

