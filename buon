local function CollectNearby()
    if not hrp then return end

    local function collectGroup(group)
        for _, item in pairs(group:GetChildren()) do
            local click = item:FindFirstChildOfClass("ClickDetector")
            if click and (hrp.Position - item.Position).Magnitude <= collectRadius then
                pcall(function() fireclickdetector(click) end)
            end
        end
    end

    if Workspace:FindFirstChild("Barrels") then
        for _, g in pairs(Workspace.Barrels:GetChildren()) do
            collectGroup(g)
        end
    end
    if Workspace:FindFirstChild("Crates") then
        for _, g in pairs(Workspace.Crates:GetChildren()) do
            collectGroup(g)
        end
    end
end

