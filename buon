-- SafeTween estilo rápido/subida instantânea
getgenv().TweenSettings = getgenv().TweenSettings or {
    MaxSpeed = 500,
    MinTweenTime = 0.5,
    MaxTweenTime = 5,
    RandomDelay = {Min=0, Max=0}
}

function SafeTween(goalPos, radius, checkContinue)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - goalPos).Magnitude
    local cfg = getgenv().TweenSettings
    local tweenTime = math.clamp(distance / cfg.MaxSpeed, cfg.MinTweenTime, cfg.MaxTweenTime)

    if distance > 25 then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, math.clamp(distance * 5, 100, 500), 0)
        task.wait(0.1)
    end

    local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(goalPos + Vector3.new(0,5,0))})
    tween:Play()
    tween.Completed:Wait()

    task.wait(cfg.RandomDelay.Min + math.random() * (cfg.RandomDelay.Max - cfg.RandomDelay.Min))

    if radius and radius > 0 then
        local parts = workspace:GetPartBoundsInRadius(goalPos, radius)
        for _, part in ipairs(parts) do
            for _, cd in ipairs(part:GetDescendants()) do
                if cd:IsA("ClickDetector") then
                    fireclickdetector(cd, 1)
                end
            end
        end
    end

    if checkContinue and not checkContinue() then return false end
    return true
end

