local ListOfRareFruits = {
    "Gravity Fruit", "Ope Fruit", "Venom Fruit", "Candy Fruit", "Hollow Fruit",
    "Chilly Fruit", "Gas Fruit", "Flare Fruit", "Light Fruit", "Smoke Fruit",
    "Sand Fruit", "Rumble Fruit", "Magma Fruit", "Snow Fruit", "Quake Fruit",
    "Phoenix Fruit", "Dark Fruit", "Vampire Fruit"
}

local ListOfIncommonFruits = {
    "Love Fruit", "Bomb Fruit", "Smelt Fruit",
    "Diamond Fruit", "Barrier Fruit", "String Fruit", "Hobby Fruit"
}

local ListOfCommonFruits = {
    "Order Fruit", "Gum Fruit", "Slip Fruit",
    "Chop Fruit", "Clone Fruit", "Hot Fruit", "Clear Fruit", "Float Fruit",
    "Spring Fruit", "Swim Fruit", "Spin Fruit", "Luck Fruit", "More Fruit",
    "Return Fruit", "Alice Fruit"
}

local function obterRaridade(nomeFruta)
    if table.find(ListOfRareFruits, nomeFruta) then
        return "Rare"
    elseif table.find(ListOfIncommonFruits, nomeFruta) then
        return "Incommon"
    elseif table.find(ListOfCommonFruits, nomeFruta) then
        return "Common"
    else
        return "Unknown"
    end
end

local function collectFruit(obj)
    for _, part in ipairs(obj:GetDescendants()) do
        if part:IsA("ClickDetector") then
            fireclickdetector(part, 1)
        end
    end
end

