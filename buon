-- === 2. Safe Auto-Farm ===
safeActivate("Safe Auto-Farm", function()
    getgenv().safeFarm = function(clickFunc)
        -- Prevents excessive clicks
        local maxPerSecond = 5
        local lastClick = 0
        return function(...)
            local now = tick()
            if now - lastClick >= 1 / maxPerSecond then
                lastClick = now
                pcall(clickFunc, ...)
            end
        end
    end
end)

