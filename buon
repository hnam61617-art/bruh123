local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

Tabs.SamFarmTab:AddToggle("ToggleCompassFarm", {
    Title = "Auto Find Compass (BETA)",
    Description = "This will automatically find the compass location!",
    Default = false,
    Callback = function(state)
        getgenv().CompassFarm = state

        if state then
            task.spawn(function()
                local character = player.Character or player.CharacterAdded:Wait()
                local hrp = character:WaitForChild("HumanoidRootPart")
                local Compass = player.Backpack:WaitForChild("Compass")

                -- Remover colisões
                local originalCanCollide = {}
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        originalCanCollide[part] = part.CanCollide
                        part.CanCollide = false
                    end
                end

                local function restoreCollisions()
                    for part, collide in pairs(originalCanCollide) do
                        if part then
                            part.CanCollide = collide
                        end
                    end
                end

                -- Gravidade
                local originalGravity = workspace.Gravity
                workspace.Gravity = 0
                local gravityConnection
                gravityConnection = workspace:GetPropertyChangedSignal("Gravity"):Connect(function()
                    if not getgenv().CompassFarm then return end
                    if workspace.Gravity ~= 0 then
                        workspace.Gravity = 0
                    end
                end)

                local function resetGravity()
                    if gravityConnection then gravityConnection:Disconnect() end
                    workspace.Gravity = originalGravity
                end
                character:WaitForChild("Humanoid").Died:Connect(function()
                    resetGravity()
                    restoreCollisions()
                end)

                -- Teleporte inicial
                local target = CFrame.new(-4006, 216, -2191)
                local distance = (hrp.Position - target.Position).Magnitude
                local travelTime = distance / 300
                local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = target})
                tween:Play()
                tween.Completed:Wait()

                Compass.Parent = player.Character
                local arrow = Compass:WaitForChild("CompassArrow")

                arrow:GetPropertyChangedSignal("Transparency"):Connect(function()
                    if arrow.Transparency == 1 and getgenv().CompassFarm then
                        player.Character:WaitForChild("Compass"):Activate()
                    end
                end)
                player.Character:WaitForChild("Compass"):Activate()

                -- Movimento automático
                local stepDistance = 25
                local tweenTime = 0.2
                local repeatCount = 500
                local smoothFactor = 0.25
                local lastLookVector = nil
                local sharpTurnDetected = false
                local sharpTurnPos = nil

                local currentPos = hrp.Position
                local originalY = hrp.Position.Y

                for i = 1, repeatCount do
                    if not getgenv().CompassFarm then break end
                    if sharpTurnDetected then break end
                    if not arrow or not arrow:FindFirstChildWhichIsA("Weld") then break end

                    local weld = arrow:FindFirstChildWhichIsA("Weld")
                    local arrowCFrame = weld.Part0.CFrame * weld.C0 * weld.C1:Inverse() * CFrame.Angles(-math.rad(90), 0, 0)
                    local rawLook = Vector3.new(arrowCFrame.LookVector.X, 0, arrowCFrame.LookVector.Z).Unit

                    local angleDiff = 0
                    if lastLookVector then
                        angleDiff = math.acos(math.clamp(lastLookVector:Dot(rawLook), -1, 1))
                        if angleDiff > math.rad(120) then
                            sharpTurnDetected = true
                            sharpTurnPos = hrp.Position
                            break
                        end
                    end

                    local moveLook = rawLook
                    if lastLookVector then
                        moveLook = (lastLookVector * (1 - smoothFactor) + rawLook * smoothFactor).Unit
                    end

                    lastLookVector = rawLook
                    local offset = moveLook * stepDistance
                    currentPos = currentPos + offset
                    currentPos = Vector3.new(currentPos.X, originalY, currentPos.Z)
                    local destCFrame = CFrame.new(currentPos, currentPos + moveLook)

                    local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = destCFrame})
                    tween:Play()
                    tween.Completed:Wait()
                end

                -- Sharp turn logic
                if sharpTurnDetected and sharpTurnPos then
                    while getgenv().CompassFarm and workspace:FindFirstChild(player.Name) and player.Character:FindFirstChild("Compass") do
                        for _, tree in pairs(workspace.Trees:GetChildren()) do
                            if tree:FindFirstChild("Spawner") then
                                local spawner = tree.Spawner
                                local dist = (spawner.Position - sharpTurnPos).Magnitude
                                if dist < 75 then
                                    hrp.CFrame = spawner.CFrame
                                    task.wait(0.25)
                                end
                            end
                        end
                        task.wait(0)
                    end
                end

                -- Reset final
                resetGravity()
                restoreCollisions()
            end)
        else
            if workspace.Gravity ~= 196.2 then
                workspace.Gravity = 196.2
            end
            -- Garantir que colisões voltam ao normal
            local character = player.Character
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end
})



