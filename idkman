-- [ CORE UTILITIES ]
local function charOk()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") and char
end

local function SafeTween(goalPos)
    local char = charOk()
    if not char then return false end
    local hrp = char.HumanoidRootPart

    while getgenv()._safeTweenBusy do task.wait() end
    getgenv()._safeTweenBusy = true

    local distance = (hrp.Position - goalPos).Magnitude
    local speed = 250
    local tweenTime = math.clamp(distance / speed, 0.2, 15)

    local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(goalPos)
    })
    tween:Play()
    tween.Completed:Wait()

    getgenv()._safeTweenBusy = false
    return true
end

-- [ LOGIC: AUTO SAM (Bay 1200m -> Rớt 5 stud) ]
local function DoSamQuest(compass)
    local char = charOk()
    if not char then return end
    local hrp = char.HumanoidRootPart

    compass.Parent = char
    local arrow = compass:WaitForChild("CompassArrow", 5)
    if not arrow then return end

    local originalCanCollide = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            originalCanCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    local function restoreCollisions()
        for part, collide in pairs(originalCanCollide) do
            if part then part.CanCollide = collide end
        end
    end

    local originalGravity = workspace.Gravity
    workspace.Gravity = 0
    local gravityConnection = workspace:GetPropertyChangedSignal("Gravity"):Connect(function()
        if workspace.Gravity ~= 0 then workspace.Gravity = 0 end
    end)

    local function resetGravity()
        if gravityConnection then gravityConnection:Disconnect() end
        workspace.Gravity = originalGravity
    end

    local diedConn = char:WaitForChild("Humanoid").Died:Connect(function()
        resetGravity()
        restoreCollisions()
        isDoingSam = false
    end)

    if arrow.Transparency == 1 then compass:Activate() end
    local transConn = arrow:GetPropertyChangedSignal("Transparency"):Connect(function()
        if arrow.Transparency == 1 and char:FindFirstChild("Compass") then
            compass:Activate()
        end
    end)

    -- BƯỚC 1: BAY LÊN 1200 MÉT
    local skyY = 1200
    SafeTween(Vector3.new(hrp.Position.X, skyY, hrp.Position.Z))

    -- BƯỚC 2: DI CHUYỂN TRÊN TRỜI
    local stepDistance = 30
    local tweenTime = 0.2
    local repeatCount = 500
    local smoothFactor = 0.25
    local lastLookVector = nil
    local sharpTurnDetected = false
    local sharpTurnPos = nil

    local currentPos = hrp.Position

    for i = 1, repeatCount do
        if not AutoSam or sharpTurnDetected then break end
        if not char:FindFirstChild("Compass") then break end
        if not arrow or not arrow:FindFirstChildWhichIsA("Weld") then break end

        local weld = arrow:FindFirstChildWhichIsA("Weld")
        local arrowCFrame = weld.Part0.CFrame * weld.C0 * weld.C1:Inverse() * CFrame.Angles(-math.rad(90), 0, 0)
        local rawLook = Vector3.new(arrowCFrame.LookVector.X, 0, arrowCFrame.LookVector.Z).Unit

        if lastLookVector then
            local dotProduct = math.clamp(lastLookVector:Dot(rawLook), -1, 1)
            local angleDiff = math.acos(dotProduct)
            if angleDiff > math.rad(120) then
                sharpTurnDetected = true
                sharpTurnPos = hrp.Position
                break
            end
        end

        local moveLook = rawLook
        if lastLookVector then moveLook = (lastLookVector * (1 - smoothFactor) + rawLook * smoothFactor).Unit end
        lastLookVector = rawLook

        currentPos = currentPos + (moveLook * stepDistance)
        currentPos = Vector3.new(currentPos.X, skyY, currentPos.Z)
        local destCFrame = CFrame.new(currentPos, currentPos + moveLook)

        local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = destCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    -- BƯỚC 3 & 4: HẠ XUỐNG VÀ TÌM SPAWNER
    if sharpTurnDetected and sharpTurnPos then
        local rayOrigin = Vector3.new(sharpTurnPos.X, skyY, sharpTurnPos.Z)
        local rayDirection = Vector3.new(0, -2000, 0)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local raycastResult = workspace:Raycast(rayOrigin, rayDirection, rayParams)
        local groundY = 215 
        if raycastResult then groundY = raycastResult.Position.Y end

        SafeTween(Vector3.new(sharpTurnPos.X, groundY + 5, sharpTurnPos.Z))
        task.wait(0.2)

        local attempts = 0
        while AutoSam and char:FindFirstChild("Compass") and attempts < 10 do
            attempts = attempts + 1
            for _, tree in pairs(workspace.Trees:GetChildren()) do
                if tree:FindFirstChild("Spawner") then
                    local spawner = tree.Spawner
                    local dist = (spawner.Position - hrp.Position).Magnitude
                    if dist < 100 then
                        hrp.CFrame = spawner.CFrame
                        task.wait(0.5)
                    end
                end
            end
            task.wait(0.5)
        end
    end

    if diedConn then diedConn:Disconnect() end
    if transConn then transConn:Disconnect() end
    resetGravity()
    restoreCollisions()
end

-- [ EVENT LOGIC: TP & CLAIM COMPASS ]
local function TriggerClaimAndSam()
    if isWaitingForSam or isDoingSam then return end

    task.spawn(function()
        isWaitingForSam = true
        local char = charOk()
        
        local samPos = nil
        local questMerchant = workspace:FindFirstChild("Merchants") and workspace.Merchants:FindFirstChild("QuestMerchant")
        if questMerchant and questMerchant:FindFirstChild("HumanoidRootPart") then
            samPos = questMerchant.HumanoidRootPart.Position
        end

        if char and samPos then
            char.HumanoidRootPart.CFrame = CFrame.new(samPos + Vector3.new(0, 0, 3), samPos)
            task.wait(0.5)
        end

        -- Gửi sự kiện Claim
        ReplicatedStorage:WaitForChild("Connections"):WaitForChild("Claim_Sam"):FireServer("Claim1")
        
        -- CHỜ ĐÚNG 0.5 GIÂY RỒI LÀM LUÔN
        task.wait(0.5)
        
        char = charOk()
        local compass = LocalPlayer.Backpack:FindFirstChild("Compass") or (char and char:FindFirstChild("Compass"))
        
        isWaitingForSam = false
        
        if compass and AutoSam then
            isDoingSam = true
            Fluent:Notify({ Title = "Sam Quest", Content = "Đã lấy được La bàn! Bắt đầu tìm kiếm...", Duration = 3 })
            DoSamQuest(compass)
            isDoingSam = false
        elseif not compass then
            Fluent:Notify({ Title = "Sam Quest", Content = "Không nhận được La bàn (Chưa tới giờ hoặc lỗi).", Duration = 3 })
        end
    end)
end

-- [ LOGIC: AUTO FISH (TP ĐẾN BỤC, CÂU & KHÔNG BÁN) ]
local function DoFishQuest()
    if not FishBlock then return end
    local char = charOk()
    if not char then return end
    
    local hrp = char.HumanoidRootPart
    local targetPos = FishBlock.Position + Vector3.new(0, 3, 0)

    -- TELEPORT ĐẾN BỤC CÂU CÁ
    if (hrp.Position - targetPos).Magnitude > 5 then
        hrp.CFrame = CFrame.new(targetPos)
        task.wait(0.3)
    end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and string.find(tool.Name, "Rod") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end

    local rod
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and string.find(tool.Name, "Rod") and tool:FindFirstChild("Click") then
            rod = tool
            break
        end
    end
    if not rod then return end

    local bobber
    for _, desc in pairs(rod:GetDescendants()) do
        if desc.Name == "Bobber" and desc:FindFirstChild("Effect") then
            bobber = desc
            break
        end
    end

    if not bobber then
        rod.Click:FireServer(hrp.Position)
        return
    end

    if bobber.Effect.Enabled then
        task.wait(0.6)
        rod.Click:FireServer(hrp.Position)
    end
end

-- [ MASTER LOOP FISHING ]
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if not isWaitingForSam and not isDoingSam then
                if AutoFish then
                    DoFishQuest()
                end
            end
        end)
    end
end)

-- [ AUTO CLAIM COMPASS LOOP (OPTIMIZED UI READING) ]
task.spawn(function()
    while task.wait(1) do
        if AutoClaimCompass and not isWaitingForSam and not isDoingSam then
            pcall(function()
                local gui = LocalPlayer:FindFirstChild("PlayerGui")
                if gui then
                    local timerUI = gui:FindFirstChild("SamTimer", true)
                    if timerUI then
                        local text = string.lower(timerUI.Text)
                        if string.find(text, "ready") or string.find(text, "claim") or text == "00:00:00" or text == "00:00" or text == "0" then
                            TriggerClaimAndSam()
                            task.wait(10) -- Cooldown 10s để không spam
                        end
                    end
                end
            end)
        end
    end
end)

