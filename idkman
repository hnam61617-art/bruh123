-- 2. CÁC HÀM HỖ TRỢ (SAFE TWEEN, CHAR OK)
-- ==========================================
local function charOk()
    local char = game.Players.LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") and char
end

local function disableCollision(model)
    if not model then return end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

getgenv().TweenSettings = { MaxSpeed = 250, MinTweenTime = 0.25, MaxTweenTime = 3, RandomDelay = { Min = 0, Max = 0 } }
getgenv()._safeTweenBusy = false

function SafeTween(goalPos, clickRadius)
    local char = charOk()
    if not char then return false end
    local hrp = char.HumanoidRootPart

    while getgenv()._safeTweenBusy do task.wait() end
    getgenv()._safeTweenBusy = true

    local distance = (hrp.Position - goalPos).Magnitude
    local cfg = getgenv().TweenSettings
    local speed = cfg.MaxSpeed or 250
    local tweenTime = math.clamp(distance / speed, cfg.MinTweenTime, cfg.MaxTweenTime)

    local tween = game:GetService("TweenService"):Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(goalPos)
    })
    tween:Play()
    tween.Completed:Wait()

    local rd = cfg.RandomDelay
    task.wait((rd.Min or 0) + math.random() * ((rd.Max or 0) - (rd.Min or 0)))

    if clickRadius and clickRadius > 0 then
        local parts = workspace:GetPartBoundsInRadius(goalPos, clickRadius)
        for _, part in ipairs(parts) do
            for _, cd in ipairs(part:GetDescendants()) do
                if cd:IsA("ClickDetector") then
                    fireclickdetector(cd, 1)
                end
            end
        end
    end

    getgenv()._safeTweenBusy = false
    return true
end

-- ==========================================
-- 3. LOGIC FARM (CÂU CÁ & BÁN CÁ + TÌM SAM)
-- ==========================================
local FishBlock = nil

Tabs.FarmTab:AddToggle("ToggleAutoFishSam", {
    Title = "Auto Fish & Sam (Priority)",
    Description = "Ưu tiên nhặt SAM 1500m. Hết la bàn sẽ đi câu & bán cá.",
    Default = false,
    Callback = function(state)
        getgenv().AutoFarm = state

        if state then
            if not FishBlock then
                FishBlock = Instance.new("Part")
                FishBlock.Name = "FishFarmPlatform"
                FishBlock.Anchored = true
                FishBlock.Size = Vector3.new(2.5, 1, 2.5)
                FishBlock.Material = Enum.Material.Plastic
                FishBlock.BrickColor = BrickColor.new("Medium stone grey")
                FishBlock.CFrame = CFrame.new(-20000, 211, 20000)
                FishBlock.Parent = workspace
            end

            task.spawn(function()
                local oldGrav = workspace.Gravity
                workspace.Gravity = 0

                local nc
                nc = game:GetService("RunService").Stepped:Connect(function()
                    if not getgenv().AutoFarm then nc:Disconnect() return end
                    local char = charOk()
                    if char then disableCollision(char) end 
                end)
                
                local height = 1500
                local stepDist = 35
                local lastLook = nil

                while getgenv().AutoFarm do
                    task.wait(0.5)
                    
                    pcall(function()
                        local char = charOk() 
                        if not char then return end
                        local hrp = char.HumanoidRootPart
                        local LocalPlayer = game.Players.LocalPlayer

                        local compass = LocalPlayer.Backpack:FindFirstChild("Compass") or char:FindFirstChild("Compass")
                        
                        if compass then
                            -- ==============================
                            -- LOGIC ĐI TÌM SAM
                            -- ==============================
                            compass.Parent = char
                            
                            if hrp.Position.Y < 1400 then
                                hrp.CFrame = CFrame.new(hrp.Position.X, height, hrp.Position.Z)
                                task.wait(0.5)
                            end

                            local arrow = compass:FindFirstChild("CompassArrow")
                            local weld = arrow and arrow:FindFirstChildWhichIsA("Weld")
                            
                            if weld then
                                local arrowCF = weld.Part0.CFrame * weld.C0 * weld.C1:Inverse() * CFrame.Angles(-math.rad(90), 0, 0)
                                local look = Vector3.new(arrowCF.LookVector.X, 0, arrowCF.LookVector.Z).Unit

                                if lastLook then
                                    local angle = math.acos(math.clamp(lastLook:Dot(look), -1, 1))
                                    if angle > math.rad(120) then
                                        local landPos = CFrame.new(hrp.Position.X, 15, hrp.Position.Z)
                                        
                                        if workspace:FindFirstChild("Trees") then
                                            for _, t in pairs(workspace.Trees:GetChildren()) do
                                                local s = t:FindFirstChild("Spawner")
                                                if s and (Vector2.new(s.Position.X, s.Position.Z) - Vector2.new(hrp.Position.X, hrp.Position.Z)).Magnitude < 100 then
                                                    landPos = s.CFrame
                                                    break
                                                end
                                            end
                                        end
                                        
                                        hrp.CFrame = landPos
                                        task.wait(3) 
                                        hrp.CFrame = CFrame.new(hrp.Position.X, height, hrp.Position.Z) 
                                        lastLook = nil
                                    end
                                end

                                lastLook = look
                                local nextP = hrp.Position + (look * stepDist)
                                hrp.CFrame = CFrame.new(Vector3.new(nextP.X, height, nextP.Z), Vector3.new(nextP.X, height, nextP.Z) + look)
                            end
                        else
                            -- ==============================
                            -- LOGIC CÂU CÁ & BÁN CÁ
                            -- ==============================
                            if not FishBlock then return end
                            local targetPos = FishBlock.Position + Vector3.new(0, 3, 0)

                            if (hrp.Position - targetPos).Magnitude > 5 then
                                SafeTween(targetPos, 0)
                            end

                            for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                                if tool:IsA("Tool") and string.find(tool.Name, "Rod") then
                                    char.Humanoid:EquipTool(tool)
                                    break
                                end
                            end

                            local rod
                            for _, tool in pairs(char:GetChildren()) do
                                if tool:IsA("Tool") and string.find(tool.Name, "Rod") and tool:FindFirstChild("Click") then
                                    rod = tool
                                    break
                                end
                            end
                            if not rod then return end

                            local bobber
                            for _, desc in pairs(rod:GetDescendants()) do
                                if desc.Name == "Bobber" and desc:FindFirstChild("Effect") then
                                    bobber = desc
                                    break
                                end
                            end

                            if not bobber then
                                rod.Click:FireServer(hrp.Position)
                                return
                            end

                            if bobber.Effect.Enabled then
                                task.wait(0.6)
                                rod.Click:FireServer(hrp.Position)

                                local retum = workspace:FindFirstChild("Merchants")
                                    and workspace.Merchants:FindFirstChild("FishMerchant")
                                    and workspace.Merchants.FishMerchant:FindFirstChild("Clickable")
                                    and workspace.Merchants.FishMerchant.Clickable:FindFirstChild("Retum")

                                if retum then
                                    local npc = workspace.Merchants.FishMerchant
                                    local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                                    if npcHrp then
                                        local pos = npcHrp.Position + (npcHrp.CFrame.LookVector * -3)
                                        pos = Vector3.new(pos.X, npcHrp.Position.Y, pos.Z)
                                        SafeTween(pos, 0) 
                                        hrp.CFrame = CFrame.new(hrp.Position, npcHrp.Position)
                                        task.wait(0.2)
                                        retum:FireServer()
                                    end
                                end
                            end
                        end
                    end)
                end
                
                workspace.Gravity = oldGrav
                if nc then nc:Disconnect() end
            end)
        else
            workspace.Gravity = 196.2
            if FishBlock then
                FishBlock:Destroy()
                FishBlock = nil
            end
        end
    end
})

